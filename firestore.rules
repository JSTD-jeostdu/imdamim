rules_version = '2';

// ============================================================
// IM-DAM-IM — Firestore 보안 규칙
//
// 핵심 원칙
//  1) 교사 데이터(classes, attendance, seatHistory)는 소유 교사만 접근한다.
//  2) 학생 열람용(public)은 누구나 읽을 수 있으므로,
//     애초에 이름·출결이 들어가지 않는 문서만 여기에 둔다.
//  3) 반 비밀번호는 보안 장치가 아니다. 실제 보호는 이 규칙이 담당한다.
//
// 이 앱은 반 문서 ID를 교사의 계정 ID(uid)로 쓴다.
// 따라서 "문서 ID == 내 uid" 만으로 소유 판정이 성립하며,
// 문서가 아직 없는 첫 로그인에서도 안전하게 통과한다.
// (문서가 없을 때 resource.data 를 읽으면 평가가 실패해 접근이 거부된다)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부
    function signedIn() {
      return request.auth != null;
    }

    // 내 반인지 — 문서가 없어도 판정할 수 있다
    function isMine(classId) {
      return signedIn() && classId == request.auth.uid;
    }

    // ---------- 우리 반 기기 등록 확인 (담벼락·단톡방 공통) ----------
    function memDoc(classId) {
      return get(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid)).data;
    }
    function isClassMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid))
        && ( ('k' in memDoc(classId) && exists(/databases/$(database)/documents/stuKeys/$(memDoc(classId).k)))
          || ('bid' in memDoc(classId) && exists(/databases/$(database)/documents/boards/$(memDoc(classId).bid))) );
    }
    // 글쓴이 표시(aid)가 그 기기와 맞는지 — 다른 친구 이름으로 쓰지 못하게
    // 담임은 학생 화면 미리보기에서 학생 칸으로도 쓸 수 있다
    function validAid(classId, aid) {
      return isMine(classId)
        || ( isClassMember(classId)
             && ( ('sid' in memDoc(classId) && aid == memDoc(classId).sid)
               || ('bid' in memDoc(classId) && aid == 't:' + request.auth.uid) ) );
    }

    // ---------- 교사 전용: 반 문서 ----------
    match /classes/{classId} {

      // 문서가 없는 첫 로그인도 통과해야 한다
      allow read: if isMine(classId);

      // 생성 시 소유자를 본인으로 강제한다
      allow create: if isMine(classId)
                    && request.resource.data.ownerUid == request.auth.uid;

      // 수정 시에도 소유자 필드는 본인이어야 한다
      allow update: if isMine(classId)
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if isMine(classId);
    }

    // ---------- 교사 전용: 출결 ----------
    // 문서 ID 형식: {classId}_{YYYY-MM-DD}
    match /attendance/{docId} {

      // docId 앞부분에서 classId 를 꺼낸다
      function classIdOf() {
        return docId.split('_')[0];
      }

      allow read, write: if isMine(classIdOf());
    }

    // ---------- 교사 전용: 자리 배치 이력 ----------
    // 문서 ID 형식: {classId}_{YYYY-MM-DD}. attendance와 동일한 패턴이다.
    // 이 문서는 saveSeatSnapshot() 한 곳에서만 쓰기 때문에 통째로 덮어써도 안전하다.
    match /seatHistory/{docId} {

      function classIdOf() {
        return docId.split('_')[0];
      }

      allow read, write: if isMine(classIdOf());
    }

    // ---------- 학생 열람용 ----------
    // 누구나 읽을 수 있다. 따라서 이 문서에는
    // 학생 이름·좌석·출결·교사 메모를 절대 넣지 않는다.
    match /public/{classId} {
      allow read: if true;
      allow write: if isMine(classId);
    }

    // ---------- 교과 출석부 ----------
    // 문서 ID(boardId)는 담임이 정한 출석부 암호에서 만든 값이다.
    // 암호를 모르면 ID를 알 수 없으므로 "목록 보기(list)"는 막고 "하나 가져오기(get)"만 연다.
    // 안의 내용(이름·출결·사유·체크)은 모두 출석부 암호로 잠근 채 저장되어 서버에서는 읽을 수 없다.
    match /boards/{boardId} {

      function boardOwner() {
        return get(/databases/$(database)/documents/boards/$(boardId)).data.ownerUid;
      }

      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // 교과 선생님이 올리는 우리 반 일정(수행평가 등) — 체크와 같은 방식: 추가만, 지우기는 담임만
      match /events/{eventId} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/boards/$(boardId))
                      && request.resource.data.keys().hasOnly(['c', 'at'])
                      && request.resource.data.c is string
                      && request.resource.data.c.size() < 4000
                      && request.resource.data.at is string
                      && request.resource.data.at.size() < 40;
        allow update: if false;
        allow delete: if signedIn() && boardOwner() == request.auth.uid;
      }

      // 날짜별 아침 출결·시간표 — 담임만 쓴다
      match /days/{date} {
        allow get: if true;
        allow list: if false;
        allow write: if signedIn() && boardOwner() == request.auth.uid;

        // 교과 선생님의 교시 체크 — 누구나 "추가"만 할 수 있다(고치기 불가).
        // 경로 자체가 비밀이므로 이 아래 목록 읽기는 연다. 지우기는 담임만(암호 바꿀 때 정리용).
        match /checks/{checkId} {
          allow read: if true;
          allow create: if exists(/databases/$(database)/documents/boards/$(boardId))
                        && request.resource.data.keys().hasOnly(['c', 'at'])
                        && request.resource.data.c is string
                        && request.resource.data.c.size() < 4000
                        && request.resource.data.at is string
                        && request.resource.data.at.size() < 40;
          allow update: if false;
          allow delete: if signedIn() && boardOwner() == request.auth.uid;
        }
      }
    }

    // ---------- 학생 개인 코드 확인값 ----------
    // 문서 ID(sh)는 학생 개인 코드에서 만든 값이다. 코드를 아는 학생만 ID를 알 수 있으므로 get 만 연다.
    // 안에는 반 ID와 학생 칸 ID(s05 같은 것)만 있다 — 이름 없음.
    match /stuKeys/{sh} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.classId == request.auth.uid;
      allow delete: if signedIn() && resource.data.classId == request.auth.uid;
    }

    // ---------- 마음의 소리함 ----------
    // voices/{반ID}/by/{학생 확인값}/items/{편지}
    // · 학생은 자기 코드로 만든 경로에만 "보내기"를 할 수 있다(그 확인값이 우리 반 것인지 확인).
    // · 내용(c)은 담임 공개키로, 학생 사본(m)·답장(reply)은 학생 코드로 잠겨 있어 서버에서는 읽을 수 없다.
    // · 담임은 읽음 표시·답장만 덧붙일 수 있고, 지울 수 있다.
    match /voices/{classId}/by/{sh}/items/{itemId} {
      allow read: if true;
      allow create: if exists(/databases/$(database)/documents/stuKeys/$(sh))
                    && get(/databases/$(database)/documents/stuKeys/$(sh)).data.classId == classId
                    && request.resource.data.keys().hasOnly(['c', 'm', 'at'])
                    && request.resource.data.c is string && request.resource.data.c.size() < 8000
                    && request.resource.data.m is string && request.resource.data.m.size() < 4000
                    && request.resource.data.at is string && request.resource.data.at.size() < 40;
      allow update: if isMine(classId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt', 'read']);
      allow delete: if isMine(classId);
    }

    // ---------- 우리 반 학생 기기 등록 (익명 로그인) ----------
    // 학생이 개인 코드를 넣으면 이름 없는 익명 계정이 "우리 반 몇 번"으로 등록된다.
    // k(코드 확인값)는 이 문서에만 있고 본인과 담임만 읽을 수 있다.
    match /members/{classId}/m/{uid} {
      function stuDoc(k) {
        return get(/databases/$(database)/documents/stuKeys/$(k)).data;
      }
      allow read: if signedIn() && (request.auth.uid == uid || isMine(classId));
      // 학생: 개인 코드 확인값(k)으로 / 교과 선생님: 교과 출석부 ID(bid)로 — 둘 다 암호를 알아야 알 수 있는 값
      allow create, update: if signedIn() && request.auth.uid == uid && (
                              ( request.resource.data.keys().hasOnly(['k', 'sid', 'at'])
                                && request.resource.data.k is string
                                && exists(/databases/$(database)/documents/stuKeys/$(request.resource.data.k))
                                && stuDoc(request.resource.data.k).classId == classId
                                && stuDoc(request.resource.data.k).sid == request.resource.data.sid )
                           || ( request.resource.data.keys().hasOnly(['bid', 'at'])
                                && request.resource.data.bid is string
                                && exists(/databases/$(database)/documents/boards/$(request.resource.data.bid))
                                && get(/databases/$(database)/documents/boards/$(request.resource.data.bid)).data.ownerUid == classId ) );
      allow delete: if signedIn() && (request.auth.uid == uid || isMine(classId));
    }

    // ---------- 프로필 (사진·캐릭터) ----------
    // 내용(c)은 반 열쇠로 잠겨 있어 우리 반 학생·선생님만 열 수 있다.
    // 학생은 등록된 기기에서 "자기 번호" 프로필만 쓸 수 있다. 담임은 모두 바꾸고 지울 수 있다.
    // 담임이 코드를 다시 만들면(stuKeys 삭제) 예전 기기는 더 이상 쓸 수 없다.
    match /profiles/{classId}/p/{sid} {
      function myMember() {
        return get(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid)).data;
      }
      function isStudentOf() {
        return signedIn()
          && exists(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid))
          && myMember().sid == sid
          && exists(/databases/$(database)/documents/stuKeys/$(myMember().k));
      }
      allow read: if true;
      allow create, update: if (isMine(classId) || isStudentOf())
                            && request.resource.data.keys().hasOnly(['c', 'at'])
                            && request.resource.data.c is string
                            && request.resource.data.c.size() < 200000
                            && request.resource.data.at is string;
      allow delete: if isMine(classId) || isStudentOf();
    }

    // ---------- 우리 반 이름 목록 (반 열쇠로 잠김) ----------
    match /classDir/{classId} {
      allow read: if true;
      allow write: if isMine(classId);
    }

    // ---------- 우리 반 담벼락 ----------
    // 우리 반으로 등록된 기기(학생·교과 선생님)와 담임만 읽고 쓴다. 내용(c)은 반 열쇠로 잠겨 있다.
    match /walls/{classId}/posts/{postId} {
      function mem() {
        return get(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid)).data;
      }
      function isMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid))
          && ( ('k' in mem() && exists(/databases/$(database)/documents/stuKeys/$(mem().k)))
            || ('bid' in mem() && exists(/databases/$(database)/documents/boards/$(mem().bid))) );
      }
      function canUse() { return isMine(classId) || isMember(); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function onlyMyKey(field) {
        return changed().hasOnly([field])
          && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow read: if canUse();
      allow create: if canUse()
        && request.resource.data.keys().hasOnly(['c', 'au', 'aid', 'at', 'st', 'rx', 'vt', 'rp', 'nc', 'hc'])
        && request.resource.data.au == request.auth.uid
        && validAid(classId, request.resource.data.aid)
        && request.resource.data.c is string && request.resource.data.c.size() < 900000
        && request.resource.data.st in ['ok', 'held']
        && request.resource.data.rx == {} && request.resource.data.vt == {} && request.resource.data.rp == {}
        && request.resource.data.nc == 0 && request.resource.data.hc == 0;
      allow update: if isMine(classId)
        // 글쓴이 — 내용 고치기 (담임이 가린 글은 못 고침)
        || ( resource.data.au == request.auth.uid && resource.data.st != 'hidden'
             && changed().hasOnly(['c', 'ed', 'st']) && request.resource.data.st in ['ok', 'held'] )
        // 우리 반 — 공감·투표·신고는 자기 칸만
        || ( isMember() && onlyMyKey('rx') )
        || ( isMember() && onlyMyKey('vt') )
        || ( isMember() && onlyMyKey('rp') && request.resource.data.rp[request.auth.uid] == true )
        // 댓글 수·보류 댓글 수는 하나씩만
        || ( isMember() && changed().hasOnly(['nc']) && request.resource.data.nc == resource.data.nc + 1 )
        || ( isMember() && changed().hasOnly(['nc', 'hc'])
             && request.resource.data.nc == resource.data.nc + 1 && request.resource.data.hc == resource.data.hc + 1 )
        || ( isMember() && changed().hasOnly(['nc']) && request.resource.data.nc == resource.data.nc - 1 );
      allow delete: if isMine(classId) || resource.data.au == request.auth.uid;

      match /cm/{commentId} {
        allow read: if canUse();
        allow create: if canUse()
          && request.resource.data.keys().hasOnly(['c', 'au', 'aid', 'at', 'st'])
          && request.resource.data.au == request.auth.uid
          && validAid(classId, request.resource.data.aid)
          && request.resource.data.c is string && request.resource.data.c.size() < 20000
          && request.resource.data.st in ['ok', 'held'];
        allow update: if isMine(classId)
          || ( resource.data.au == request.auth.uid && resource.data.st != 'hidden'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c', 'ed', 'st'])
               && request.resource.data.st in ['ok', 'held'] );
        allow delete: if isMine(classId) || resource.data.au == request.auth.uid;
      }
    }

    // ---------- 오늘의 기분 ----------
    // 학생 본인(등록된 기기)과 담임만 읽고 쓴다. 같은 반 친구도 읽을 수 없다. 내용은 반 열쇠로 잠겨 있다.
    match /moods/{classId}/d/{date}/s/{sid} {
      function moodMember() {
        return get(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid)).data;
      }
      function isThisStudent() {
        return signedIn()
          && exists(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid))
          && moodMember().sid == sid
          && exists(/databases/$(database)/documents/stuKeys/$(moodMember().k));
      }
      allow read: if isMine(classId) || isThisStudent();
      allow create, update: if (isMine(classId) || isThisStudent())
                            && request.resource.data.keys().hasOnly(['c', 'at'])
                            && request.resource.data.c is string && request.resource.data.c.size() < 4000
                            && request.resource.data.at is string;
      allow delete: if isMine(classId);
    }

    // ---------- 오늘의 기분 — 친구에게 공개한 것 (이모지만) ----------
    // 학생이 「친구들에게도 보여 주기」를 켠 경우에만 생긴다. 한 줄 메모는 들어가지 않는다.
    // 우리 반으로 등록된 기기와 담임만 읽고, 쓰기·지우기는 그 학생 본인과 담임만.
    match /moodsPub/{classId}/d/{date}/s/{sid} {
      function pm() {
        return get(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid)).data;
      }
      function pIsMember() {
        return signedIn()
          && exists(/databases/$(database)/documents/members/$(classId)/m/$(request.auth.uid))
          && ( ('k' in pm() && exists(/databases/$(database)/documents/stuKeys/$(pm().k)))
            || ('bid' in pm() && exists(/databases/$(database)/documents/boards/$(pm().bid))) );
      }
      function pIsThisStudent() {
        return pIsMember() && 'sid' in pm() && pm().sid == sid;
      }
      allow read: if isMine(classId) || pIsMember();
      allow create, update: if (isMine(classId) || pIsThisStudent())
                            && request.resource.data.keys().hasOnly(['c', 'at'])
                            && request.resource.data.c is string && request.resource.data.c.size() < 1000
                            && request.resource.data.at is string;
      allow delete: if isMine(classId) || pIsThisStudent();
    }

    // ---------- 우리 반 단톡방 ----------
    // chats/{반}            방 상태 — frozen(방 얼리기), muted{글쓴이: 끝나는 시각(ms)} — 담임만 쓴다
    // chats/{반}/msgs/{메시지} 내용(c)은 반 열쇠로 잠김. 공감·신고는 자기 칸만.
    // chats/{반}/reads/{로그인ID} 내가 어디까지 읽었는지 (읽음 표시)
    match /chats/{classId} {
      allow read: if isMine(classId) || isClassMember(classId);
      allow write: if isMine(classId);

      match /msgs/{msgId} {
        function cmeta() {
          return get(/databases/$(database)/documents/chats/$(classId)).data;
        }
        // 방이 얼었거나 이 글쓴이가 말하기 멈춤 중이면 못 쓴다 (담임은 예외)
        function notBlocked() {
          return !exists(/databases/$(database)/documents/chats/$(classId))
            || ( cmeta().get('frozen', false) == false
                 && cmeta().get('muted', {}).get(request.resource.data.aid, 0) < request.time.toMillis() );
        }
        function chOnlyMyKey(field) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
            && request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
        }
        allow read: if isMine(classId) || isClassMember(classId);
        allow create: if (isMine(classId) || (isClassMember(classId) && notBlocked()))
          && validAid(classId, request.resource.data.aid)
          && request.resource.data.keys().hasOnly(['c', 'au', 'aid', 'at', 'st', 'rx', 'rp'])
          && request.resource.data.au == request.auth.uid
          && request.resource.data.c is string && request.resource.data.c.size() < 300000
          && request.resource.data.st in ['ok', 'held']
          && request.resource.data.rx == {} && request.resource.data.rp == {};
        allow update: if isMine(classId)
          || ( isClassMember(classId) && chOnlyMyKey('rx') )
          || ( isClassMember(classId) && chOnlyMyKey('rp') && request.resource.data.rp[request.auth.uid] == true );
        allow delete: if isMine(classId) || resource.data.au == request.auth.uid;
      }

      match /reads/{uid} {
        allow read: if isMine(classId) || isClassMember(classId);
        allow write: if signedIn() && request.auth.uid == uid
          && (isMine(classId) || isClassMember(classId))
          && request.resource.data.keys().hasOnly(['at', 'aid']);
      }
    }

    // ---------- 그 외 전부 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
